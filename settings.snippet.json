{
  "_comment": "Слить ЭТО в ~/.claude/settings.json студента. Если файл уже есть — добавить ключи outputStyle и hooks, не снося существующие настройки. Поле _comment из итогового файла удалить.",
  "outputStyle": "student",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash $HOME/.claude/hooks/session_start.sh" } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "bash $HOME/.claude/hooks/pre_compact.sh" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "bash $HOME/.claude/hooks/anti_fabrication_check.sh" } ] }
    ]
  }
}
